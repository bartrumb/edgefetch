{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.all-in-one"
  },
  "deploy": {
    "startCommand": "EDGEFETCH_TRUST_PROXY=1 EDGEFETCH_PUBLIC_ORIGIN=\"${EDGEFETCH_PUBLIC_ORIGIN:-${RAILWAY_PUBLIC_DOMAIN:+https://${RAILWAY_PUBLIC_DOMAIN}}}\" /usr/local/bin/all-in-one-entrypoint.sh",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
