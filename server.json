{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.bartrumb/edgefetch",
  "description": "Self-hosted scrape, map, crawl, extract, interact, search, and autonomous BYO-LLM agent MCP server (stdio & OAuth 2.1 HTTP).",
  "repository": {
    "url": "https://github.com/bartrumb/edgefetch",
    "source": "github"
  },
  "version": "2.5.3",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/bartrumb/edgefetch-agent:latest",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://edgefetch.example.com/mcp"
    }
  ]
}
