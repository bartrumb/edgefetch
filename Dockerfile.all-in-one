# All-in-One Self-Hosted EdgeFetch Container (Fly.io, Railway, Render, Coolify, or standalone Docker).
# Packages the full Go-First Self-Hosted Hub (`edgefetch --mode=hub`: `/admin`, OAuth 2.1, 17-tool `/mcp`, pure-Go BM25,
# `/data/hub` artifacts, OTLP) together with a local Go `edgefetch --mode=agent` worker + Headless Chromium + Poppler PDF
# — zero Node.js, zero Postgres, zero Redis!
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS go-build
ARG TARGETARCH
ARG BUILD_VERSION=2.8.0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-$(go env GOARCH)} go build -trimpath \
      -ldflags="-s -w -X github.com/bartrumb/edgefetch/v2/internal/agent.Version=${BUILD_VERSION}" \
      -o /out/edgefetch ./cmd/edgefetch

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
LABEL org.opencontainers.image.title="EdgeFetch All-in-One" \
      org.opencontainers.image.description="Self-hosted Pure-Go EdgeFetch Hub + Go HTTP/2 + Headless Chromium + BM25 Search in one container" \
      org.opencontainers.image.source="https://github.com/bartrumb/edgefetch" \
      org.opencontainers.image.licenses="MIT AND FSL-1.1-MIT" \
      io.modelcontextprotocol.server.name="io.github.bartrumb/edgefetch"

RUN apk add --no-cache \
      ca-certificates \
      chromium \
      chromium-swiftshader \
      font-noto \
      poppler-utils \
      su-exec \
      ttf-freefont \
      tzdata \
    && addgroup -g 1000 -S edgefetch-hub \
    && adduser -u 1000 -S -G edgefetch-hub -h /data/hub -s /sbin/nologin edgefetch-hub \
    && addgroup -g 65532 -S edgefetch \
    && adduser -u 65532 -S -G edgefetch -h /tmp -s /sbin/nologin edgefetch \
    && mkdir -p /app/hub /data/hub /tmp /var/cache/fontconfig \
    && chown root:edgefetch-hub /data \
    && chmod 0710 /data \
    && chown edgefetch-hub:edgefetch-hub /data/hub \
    && chmod 0700 /data/hub \
    && chmod 1777 /tmp /var/cache/fontconfig

COPY --from=go-build /out/edgefetch /usr/local/bin/edgefetch
COPY hub/LICENSE /app/hub/LICENSE
COPY scripts/all-in-one-entrypoint.sh /usr/local/bin/all-in-one-entrypoint.sh
RUN chown -R root:root /app /usr/local/bin/edgefetch /usr/local/bin/all-in-one-entrypoint.sh \
    && chmod -R a-w /app \
    && chmod 0755 /usr/local/bin/edgefetch /usr/local/bin/all-in-one-entrypoint.sh

# Entrypoint starts as root solely to lock mounted `/data/hub` (`0700` `1000:1000`) and immediately drops via `su-exec`
# into two isolated UIDs: Hub runs as `edgefetch-hub` (`1000:1000`) while the Go worker + Chromium run as `65532:65532`
# with `env -i` (refuses `--user != 0` unless `EDGEFETCH_ALLOW_SHARED_UID=1` or `EDGEFETCH_DISABLE_LOCAL_AGENT=1`).
USER root
WORKDIR /app/hub
ENV PORT=8787 \
    EDGEFETCH_DATA_DIR=/data/hub \
    EDGEFETCH_CHROME_BIN=/usr/lib/chromium/chromium \
    GOMEMLIMIT=384MiB \
    HOME=/tmp
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/all-in-one-entrypoint.sh"]
