# All-in-One Self-Hosted EdgeFetch Container (Fly.io, Railway, Render, Coolify, or standalone Docker).
# Packages the full TypeScript Hub (`/admin`, OAuth 2.1, 14-tool `/mcp`, `node:sqlite` FTS5, `/data/hub` artifacts, OTLP)
# together with a local Go `edgefetch` worker + Headless Chromium + Poppler PDF — zero Postgres, zero Redis!
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS go-build
ARG TARGETARCH
ARG BUILD_VERSION=2.5.5
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH:-$(go env GOARCH)} go build -trimpath \
      -ldflags="-s -w -X github.com/bartrumb/edgefetch/v2/internal/agent.Version=${BUILD_VERSION}" \
      -o /out/edgefetch ./cmd/edgefetch

FROM --platform=$BUILDPLATFORM node:26-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5 AS hub-build
WORKDIR /app/hub
COPY hub/package.json hub/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY sdk ../sdk
COPY hub/src ./src
COPY hub/migrations ./migrations
COPY hub/portable ./portable
COPY hub/scripts ./scripts
RUN npm run build:portable

FROM node:26-alpine@sha256:6bd9ab43c0ec0190ca7b2d193906cb8b7edf6e7f4afa43ddeccd6452710bffb5
LABEL org.opencontainers.image.title="EdgeFetch All-in-One" \
      org.opencontainers.image.description="Self-hosted EdgeFetch Hub + Go HTTP/2 + Headless Chromium + SQLite FTS5 in one container" \
      org.opencontainers.image.source="https://github.com/bartrumb/edgefetch" \
      org.opencontainers.image.licenses="MIT" \
      io.modelcontextprotocol.server.name="io.github.bartrumb/edgefetch"

RUN apk add --no-cache \
      ca-certificates \
      chromium \
      chromium-swiftshader \
      font-noto \
      poppler-utils \
      su-exec \
      ttf-freefont \
      tzdata \
    && mkdir -p /app/hub/dist /app/hub/migrations /data/hub /tmp /var/cache/fontconfig \
    && chown root:node /data \
    && chmod 0710 /data \
    && chown node:node /data/hub \
    && chmod 0700 /data/hub \
    && chmod 1777 /tmp /var/cache/fontconfig

COPY --from=go-build /out/edgefetch /usr/local/bin/edgefetch
COPY --from=hub-build /app/hub/dist/portable-server.mjs /app/hub/dist/portable-server.mjs
COPY hub/migrations /app/hub/migrations
COPY scripts/all-in-one-entrypoint.sh /usr/local/bin/all-in-one-entrypoint.sh
RUN chown -R root:root /app /usr/local/bin/edgefetch /usr/local/bin/all-in-one-entrypoint.sh \
    && chmod -R a-w /app \
    && chmod 0755 /usr/local/bin/edgefetch /usr/local/bin/all-in-one-entrypoint.sh

# Entrypoint starts as root solely to lock mounted `/data/hub` (`0700` `node:node`) and immediately drops via `su-exec`
# into two isolated UIDs: Hub runs as `node:node` (`1000:1000`) while the Go worker + Chromium run as `65532:65532`
# with `env -i` (refuses `--user != 0` unless `EDGEFETCH_ALLOW_SHARED_UID=1` or `EDGEFETCH_DISABLE_LOCAL_AGENT=1`).
USER root
WORKDIR /app/hub
ENV PORT=8787 \
    EDGEFETCH_DATA_DIR=/data/hub \
    EDGEFETCH_CHROME_BIN=/usr/lib/chromium/chromium \
    GOMEMLIMIT=384MiB \
    HOME=/tmp
EXPOSE 8787
ENTRYPOINT ["/usr/local/bin/all-in-one-entrypoint.sh"]
