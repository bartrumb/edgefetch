{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.bartrumb/edgefetch",
  "title": "EdgeFetch",
  "description": "Self-hosted web scraping, search, and BYO-LLM research MCP server in one Go binary.",
  "websiteUrl": "https://edgefetch.dev",
  "repository": {
    "url": "https://github.com/bartrumb/edgefetch",
    "source": "github"
  },
  "version": "2.8.19",
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/bartrumb/edgefetch-agent:2.8.19",
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
